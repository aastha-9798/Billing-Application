<UserControl x:Class="PlateBilling.Controls.SuggestionBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- Text the user types into. Styled by the host's implicit TextBox style. -->

        <TextBox x:Name="InputBox"
                 TextChanged="InputBox_TextChanged"
                 PreviewKeyDown="InputBox_PreviewKeyDown"
                 LostKeyboardFocus="InputBox_LostKeyboardFocus"/>


        <!-- Suggestions shown under the text box while typing. -->

        <Popup x:Name="SuggestionPopup"
               PlacementTarget="{Binding ElementName=InputBox}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               MinWidth="{Binding ActualWidth, ElementName=InputBox}">

            <Border Background="#FFFFFF"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    Margin="0,4,0,0">

                <ListBox x:Name="SuggestionList"
                         Focusable="False"
                         BorderThickness="0"
                         MaxHeight="260"
                         FontSize="15"
                         Foreground="#172033"
                         DisplayMemberPath="{Binding DisplayMemberPath,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="SuggestionList_PreviewMouseLeftButtonDown">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <!-- Keep keyboard focus in the text box. -->
                            <Setter Property="Focusable"
                                    Value="False"/>

                            <Setter Property="Cursor"
                                    Value="Hand"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="5"
                                                Padding="10,7">
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="#F5F6FA"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected"
                                                     Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="#EEF2FF"/>
                                                <Setter Property="Foreground"
                                                        Value="#4338CA"/>
                                                <Setter Property="FontWeight"
                                                        Value="SemiBold"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>

                </ListBox>

            </Border>

        </Popup>

    </Grid>

</UserControl>
