<Window x:Class="PlateBilling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PlateBilling.Views"
        Title="Plate Billing"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ========================================= -->
        <!-- SIDEBAR BUTTON                            -->
        <!-- ========================================= -->

        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <!-- ============================================= -->
    <!-- APPLICATION LAYOUT                            -->
    <!-- ============================================= -->

    <Grid Background="#F6F7FB">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ========================================= -->
        <!-- SIDEBAR                                   -->
        <!-- ========================================= -->

        <Border Grid.Column="0"
                Background="#1F2937">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- ================================= -->
                <!-- LOGO                              -->
                <!-- ================================= -->

                <StackPanel Grid.Row="0"
                            Margin="24,20,10,30">

                    <TextBlock Text="PLATE"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="BILLING"
                               Foreground="#9CA3AF"
                               FontSize="14"
                               FontWeight="SemiBold"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- NAVIGATION                         -->
                <!-- ================================= -->

                <StackPanel Grid.Row="1"
                            Margin="12,0,12,0">


                    <!-- Challan Entry -->

                    <Button x:Name="ChallanEntryButton"
                            Content="Challan Entry"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ChallanEntryButton_Click"/>


                    <!-- Clients -->

                    <Button x:Name="ClientsButton"
                            Content="Clients"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ClientsButton_Click"/>


                    <!-- Plate Types -->

                    <Button x:Name="PlateTypesButton"
                            Content="Plate Types"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="PlateTypesButton_Click"/>


                    <!-- Rates -->

                    <Button x:Name="RatesButton"
                            Content="Rates"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="RatesButton_Click"/>


                    <!-- Reports -->

                    <Button x:Name="ReportsButton"
                            Content="Reports"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="ReportsButton_Click"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- SETTINGS                           -->
                <!-- ================================= -->

                <Button Grid.Row="2"
                        x:Name="SettingsButton"
                        Content="Settings"
                        Style="{StaticResource SidebarButtonStyle}"
                        Margin="12,8,12,12"
                        Click="SettingsButton_Click"/>

            </Grid>

        </Border>


        <!-- ========================================= -->
        <!-- MAIN CONTENT                              -->
        <!-- ========================================= -->

        <Grid Grid.Column="1"
              Margin="28">

            <ContentControl x:Name="MainContent"/>

        </Grid>

    </Grid>

</Window>