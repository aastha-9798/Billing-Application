<Window x:Class="PlateBilling.Views.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Preview"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7FB">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Challan Report"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock x:Name="PeriodText"
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="ClientText"
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,2,0,0"/>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Save PDF"
                        Width="110"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="SavePdfButton_Click"/>   

                <Button Content="Print"
                        Width="110"
                        Height="42"
                        Background="#667085"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="PrintButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- REPORT                                            -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                <DataGrid x:Name="ReportGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Client Name"
                                            Binding="{Binding ClientName}"
                                            Width="170"/>

                        <DataGridTextColumn Header="Challan No."
                                            Binding="{Binding ChallanNo}"
                                            Width="130"/>

                        <DataGridTextColumn Header="Plate Type"
                                            Binding="{Binding PlateTypeCode}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Rate"
                                            Binding="{Binding Rate,
                                                     StringFormat={}{0:₹#,##0.00}}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount,
                                                     StringFormat={}{0:₹#,##0.00}}"
                                            Width="130"/>

                    </DataGrid.Columns>

                </DataGrid>

            </ScrollViewer>

        </Border>


        <!-- ================================================= -->
        <!-- GRAND TOTAL                                       -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,14,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Grand Total"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="GrandTotalText"
                           Grid.Column="1"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>