<UserControl x:Class="PlateBilling.Views.ChallanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="ChallanView_PreviewKeyDown">

    <UserControl.Resources>

        <!-- ========================================= -->
        <!-- COLORS                                    -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="PageBackgroundBrush"
                         Color="#F6F7FB"/>

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#667085"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E4E7EC"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4F46E5"/>

        <SolidColorBrush x:Key="AccentHoverBrush"
                         Color="#4338CA"/>

        <SolidColorBrush x:Key="DangerBrush"
                         Color="#B42318"/>


        <!-- ========================================= -->
        <!-- CARD                                      -->
        <!-- ========================================= -->

        <Style x:Key="CardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ========================================= -->
        <!-- FIELD LABEL                               -->
        <!-- ========================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ========================================= -->
        <!-- TEXTBOX                                   -->
        <!-- ========================================= -->

        <Style TargetType="TextBox">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="11,7"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================= -->
        <!-- COMBOBOX                                  -->
        <!-- ========================================= -->

        <Style TargetType="ComboBox">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="9,5"/>

            <Setter Property="Height"
                    Value="42"/>

        </Style>


        <!-- ========================================= -->
        <!-- DATE PICKER                               -->
        <!-- ========================================= -->

        <Style TargetType="DatePicker">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Height"
                    Value="42"/>

        </Style>


        <!-- ========================================= -->
        <!-- CHECKBOX                                  -->
        <!-- ========================================= -->

        <Style TargetType="CheckBox">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

        </Style>


        <!-- ========================================= -->
        <!-- PRIMARY BUTTON                            -->
        <!-- ========================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="130"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- SECONDARY BUTTON                          -->
        <!-- ========================================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="120"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#F2F4F7"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- DANGER BUTTON                             -->
        <!-- ========================================= -->

        <Style x:Key="DangerButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="120"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource DangerBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- DATAGRID                                  -->
        <!-- ========================================= -->

        <Style TargetType="DataGrid">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="40"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEF0F4"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#EEF0F4"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>


        <Style TargetType="DataGridColumnHeader">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#F8F9FC"/>

            <Setter Property="Padding"
                    Value="12,10"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================= -->
    <!-- PAGE                                          -->
    <!-- ============================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================= -->
        <!-- PAGE HEADER                               -->
        <!-- ========================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="Challan Entry"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Enter and manage challan transactions"
                           FontSize="15"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <Border Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,8"
                    VerticalAlignment="Center">

                <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

            </Border>

        </Grid>


        <!-- ========================================= -->
        <!-- MAIN CONTENT                              -->
        <!-- ========================================= -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="6*"/>

                <RowDefinition Height="4*"/>

            </Grid.RowDefinitions>


            <!-- ===================================== -->
            <!-- TRANSACTIONS                           -->
            <!-- ===================================== -->

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,12">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Filter bar -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="From"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                    Width="140"
                                    Margin="0,0,16,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="To"
                                   Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker Grid.Column="3"
                                    SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                    Width="140"/>

                    </Grid>


                    <!-- Transaction table -->

                    <DataGrid x:Name="ChallansGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Challans}"
                              SelectedItem="{Binding SelectedChallan, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}"
                                                Width="105"/>

                            <DataGridTextColumn Header="Client"
                                                Binding="{Binding Client.Name}"
                                                Width="1.4*"/>

                            <DataGridTextColumn Header="Challan"
                                                Binding="{Binding ChallanNo}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding PlateDescription}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Plate"
                                                Binding="{Binding PlateType.Code}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Quantity}"
                                                Width="65"/>

                            <DataGridTextColumn Header="Area"
                                                Binding="{Binding AreaBilling}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding TotalCost, StringFormat={}{0:N2}}"
                                                Width="125"/>

                        </DataGrid.Columns>

                    </DataGrid>


                    <!-- Transaction actions -->

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"/>


                        <Button Grid.Column="1"
                                Content="Cancel Edit"
                                Command="{Binding CancelEditCommand}"
                                Margin="0,0,10,0">      

                            <Button.Style>
                                <Style TargetType="Button"
                                         BasedOn="{StaticResource SecondaryButtonStyle}">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditing}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Button.Style>

                        </Button>


                        <Button Grid.Column="2"
                                Content="Delete Entry"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteChallanCommand}"/>

                    </Grid>

                </Grid>

            </Border>


            <!-- ===================================== -->
            <!-- CHALLAN ENTRY                          -->
            <!-- ===================================== -->

            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================= -->
                    <!-- ENTRY HEADER + STATUS              -->
                    <!-- ================================= -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- Entry heading -->

                        <TextBlock Grid.Column="0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Text"
                                            Value="New Challan Entry"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsEditing}"
                                                     Value="True">

                                            <Setter Property="Text"
                                                    Value="Edit Challan Entry"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>


                        <!-- Status message -->

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   MaxWidth="450"/>

                    </Grid>


                    <!-- ================================= -->
                    <!-- FORM                               -->
                    <!-- ================================= -->

                    <Grid Grid.Row="1">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- ================================= -->
                        <!-- ROW 1                              -->
                        <!-- ================================= -->

                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="1.7*"/>

                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="1.7*"/>

                            </Grid.ColumnDefinitions>


                            <!-- Date -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Date"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <DatePicker x:Name="DateInput"
                                            SelectedDate="{Binding Date,
                                            Mode=TwoWay}"/>

                            </StackPanel>


                            <!-- Client -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,14,0">
    
                                <TextBlock Text="Client"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="ClientInput"
                                          ItemsSource="{Binding Clients}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedClient,
                                          Mode=TwoWay}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          IsDropDownOpen="False"/>

                            </StackPanel>


                            <!-- Challan -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Challan No."
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="ChallanInput"
                                         Text="{Binding ChallanNo,
                                         UpdateSourceTrigger=PropertyChanged}"
                                        PreviewTextInput="ChallanInput_PreviewTextInput"
                                         DataObject.Pasting="ChallanInput_Pasting"
                                         PreviewKeyDown="ChallanInput_PreviewKeyDown"/>

                            </StackPanel>


                            <!-- Description -->

                            <StackPanel Grid.Column="3">

                                <TextBlock Text="Plate Description"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="DescriptionInput"
                                         Text="{Binding PlateDescription,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                        </Grid>


                        <!-- ================================= -->
                        <!-- ROW 2                              -->
                        <!-- ================================= -->

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="1*"/>

                                <ColumnDefinition Width="0.8*"/>

                                <ColumnDefinition Width="1.1*"/>

                                <ColumnDefinition Width="1.4*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <!-- Plate Type -->

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Plate Type"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox x:Name="PlateTypeInput"
                                          ItemsSource="{Binding PlateTypes}"
                                          DisplayMemberPath="Code"
                                          SelectedItem="{Binding SelectedPlateType,
                                          Mode=TwoWay}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          IsDropDownOpen="False"/>

                            </StackPanel>


                            <!-- Quantity -->

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Quantity"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox x:Name="QuantityInput"
                                         Text="{Binding Quantity,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>


                            <!-- Area Billing -->

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Billing Method"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <CheckBox x:Name="AreaBillingInput"
                                          Content="Area billing"
                                          IsChecked="{Binding AreaBilling,
                                          Mode=TwoWay}"
                                          VerticalAlignment="Center"/>

                            </StackPanel>


                            <!-- Cost -->

                            <StackPanel Grid.Column="3"
                                        Margin="0,0,14,0">

                                <TextBlock Text="Amount"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding CurrentClientRate,
                                              StringFormat={}{0:N2}}"
                                               FontSize="14"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,15,0"/>

                                    <TextBlock Text="{Binding TotalCost,
                                              StringFormat={}{0:N2}}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                </StackPanel>

                            </StackPanel>


                            <!-- Save / Update -->

                            <Button x:Name="SaveButton"
                                    Grid.Column="4"
                                    Command="{Binding SaveChallanCommand}"
                                    FocusVisualStyle="{x:Null}"
                                    VerticalAlignment="Bottom">

                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource PrimaryButtonStyle}">

                                        <Setter Property="Content"
                                                Value="Save Entry"/>

                                        <!-- Custom ControlTemplate so we fully own
                                             the visual tree — no Chrome layer. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Root"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="Root"
                                                                    Property="Background"
                                                                    Value="#4338CA"/>
                                                        </Trigger>

                                                        <Trigger Property="IsKeyboardFocused"
                                                                 Value="True">
                                                            <Setter TargetName="Root"
                                                                    Property="Background"
                                                                    Value="#FBBF24"/>
                                                            <Setter TargetName="Root"
                                                                    Property="BorderBrush"
                                                                    Value="#D97706"/>
                                                            <Setter TargetName="Root"
                                                                    Property="BorderThickness"
                                                                    Value="3"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#172033"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                            <Setter TargetName="Root"
                                                                    Property="Background"
                                                                    Value="#3730A3"/>
                                                        </Trigger>

                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsEditing}"
                                                         Value="True">
                                                <Setter Property="Content"
                                                        Value="Update Entry"/>
                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </Button.Style>

                            </Button>

                        </Grid>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>