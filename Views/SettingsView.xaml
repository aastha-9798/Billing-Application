<UserControl x:Class="PlateBilling.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <SolidColorBrush x:Key="PageBackgroundBrush"   Color="#F6F7FB"/>
        <SolidColorBrush x:Key="CardBackgroundBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryTextBrush"      Color="#172033"/>
        <SolidColorBrush x:Key="SecondaryTextBrush"    Color="#667085"/>
        <SolidColorBrush x:Key="BorderBrush"           Color="#E4E7EC"/>
        <SolidColorBrush x:Key="AccentBrush"           Color="#4F46E5"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="15"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Margin"        Value="0,0,0,7"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize"               Value="16"/>
            <Setter Property="Foreground"             Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderBrush"            Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="12,7"/>
            <Setter Property="Height"                 Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height"         Value="42"/>
            <Setter Property="MinWidth"       Value="120"/>
            <Setter Property="Padding"        Value="18,0"/>
            <Setter Property="FontSize"       Value="15"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="Background"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height"          Value="42"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background"      Value="#F2F4F7"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <!-- Read-only, selectable path display -->
        <Style x:Key="PathBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Background"      Value="#F8F9FC"/>
        </Style>

    </UserControl.Resources>


    <!-- ============================================= -->
    <!-- PAGE                                          -->
    <!-- ============================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="4">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================= -->
        <!-- HEADER                                    -->
        <!-- ========================================= -->

        <StackPanel Grid.Row="0"
                    Margin="4,0,4,24">

            <TextBlock Text="Settings"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}"/>

            <TextBlock Text="Configure application settings"
                       FontSize="16"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ========================================= -->
        <!-- SETTINGS FORM                             -->
        <!-- ========================================= -->

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="14"
                Padding="24"
                Margin="0,0,0,16"
                MaxWidth="600"
                HorizontalAlignment="Left">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Section title -->

                <TextBlock Grid.Row="0"
                           Text="Billing Rates"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,20"/>


                <!-- Global Area Rate -->

                <StackPanel Grid.Row="1"
                            Margin="0,0,0,20"
                            Width="280"
                            HorizontalAlignment="Left">

                    <TextBlock Text="Global Area Rate (₹ per m²)"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Text="Used when area billing is enabled on a challan."
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,10"/>

                    <TextBox Text="{Binding GlobalAreaRate,
                                           UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- Save + Status -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Save Settings"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding SaveCommand}"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               TextWrapping="Wrap"/>

                </Grid>

            </Grid>

        </Border>

        <!-- ========================================= -->
        <!-- DATA & BACKUPS                            -->
        <!-- ========================================= -->

        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="14"
                Padding="24"
                MaxWidth="900"
                HorizontalAlignment="Left">

            <StackPanel>

                <TextBlock Text="Data &amp; Backups"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20">
                    A full backup is made automatically when the app starts (once a day) and every time it closes.
                    Kept: daily backups for 30 days, monthly backups for 12 months, and yearly backups for ever.
                    If the database goes missing or is damaged, the app restores the latest good backup when it starts.
                    To protect against losing this PC, choose a OneDrive / Google Drive folder or a USB drive.
                </TextBlock>


                <!-- Database location -->

                <TextBlock Text="Database file"
                           Style="{StaticResource FieldLabelStyle}"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding DatabasePath, Mode=OneWay}"
                             Style="{StaticResource PathBoxStyle}"/>

                    <Button Grid.Column="1"
                            Content="Open Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="OpenDatabaseFolder_Click"/>
                </Grid>


                <!-- Backup folder -->

                <TextBlock Text="Backup folder"
                           Style="{StaticResource FieldLabelStyle}"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Text="{Binding BackupFolder, Mode=OneWay}"
                             Style="{StaticResource PathBoxStyle}"/>

                    <Button Grid.Column="1"
                            Content="Change…"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="ChangeBackupFolder_Click"/>

                    <Button Grid.Column="2"
                            Content="Open Folder"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="OpenBackupFolder_Click"/>
                </Grid>


                <!-- Last backup + Back up now -->

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Last backup:"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding LastBackupText}"
                                   FontSize="15"
                                   Foreground="{StaticResource PrimaryTextBrush}"/>

                        <TextBlock Text="{Binding BackupStatus}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">

                        <Button Content="Restore from Backup…"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="16,0,0,0"
                                Click="RestoreBackup_Click"/>

                        <Button Content="Back Up Now"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding BackUpNowCommand}"
                                Margin="10,0,0,0"/>

                    </StackPanel>
                </Grid>

            </StackPanel>

        </Border>

    </Grid>

    </ScrollViewer>

</UserControl>
