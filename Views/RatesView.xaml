<UserControl x:Class="PlateBilling.Views.RatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ========================================= -->
        <!-- COLORS                                    -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="PageBackgroundBrush"
                         Color="#F6F7FB"/>

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="PrimaryTextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#667085"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E4E7EC"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4F46E5"/>


        <!-- ========================================= -->
        <!-- FIELD LABEL                               -->
        <!-- ========================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ========================================= -->
        <!-- TEXTBOX                                   -->
        <!-- ========================================= -->

        <Style TargetType="TextBox">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,7"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================= -->
        <!-- COMBOBOX                                  -->
        <!-- ========================================= -->

        <Style TargetType="ComboBox">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,6"/>

            <Setter Property="Height"
                    Value="42"/>

        </Style>


        <!-- ========================================= -->
        <!-- PRIMARY BUTTON                            -->
        <!-- ========================================= -->

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="95"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- SECONDARY BUTTON                          -->
        <!-- ========================================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="MinWidth"
                    Value="95"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#F2F4F7"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ========================================= -->
        <!-- DATAGRID                                  -->
        <!-- ========================================= -->

        <Style TargetType="DataGrid">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="{StaticResource PrimaryTextBrush}"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="RowHeight"
                    Value="46"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEF0F4"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#EEF0F4"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>


        <!-- ========================================= -->
        <!-- DATAGRID HEADER                           -->
        <!-- ========================================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="Background"
                    Value="#F8F9FC"/>

            <Setter Property="Padding"
                    Value="14,12"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================= -->
    <!-- PAGE                                          -->
    <!-- ============================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}"
          Margin="4">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================================= -->
        <!-- HEADER                                    -->
        <!-- ========================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,24">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="Plate Rates"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryTextBrush}"/>

                <TextBlock Text="Manage client-specific plate rates"
                           FontSize="16"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="+ Add Rate"
                    Style="{StaticResource ActionButtonStyle}"
                    Width="125"
                    VerticalAlignment="Center"
                    Command="{Binding AddRateCommand}"/>

        </Grid>


        <!-- ========================================= -->
        <!-- RATE FORM                                 -->
        <!-- ========================================= -->

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="14"
                Padding="24"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="2*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ================================= -->
                <!-- CLIENT                             -->
                <!-- ================================= -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,18,0">

                    <TextBlock Text="Client"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox ItemsSource="{Binding Clients}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedClient,
                                                     Mode=TwoWay}"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- PLATE TYPE                         -->
                <!-- ================================= -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,18,0">

                    <TextBlock Text="Plate Type"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox ItemsSource="{Binding PlateTypes}"
                              DisplayMemberPath="Code"
                              SelectedItem="{Binding SelectedPlateType,
                                                     Mode=TwoWay}"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- RATE                               -->
                <!-- ================================= -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,18,0">

                    <TextBlock Text="Rate (₹)"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding NewRate,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- ================================= -->
                <!-- SAVE                               -->
                <!-- ================================= -->

                <Button Grid.Column="3"
                        Content="Save"
                        Style="{StaticResource ActionButtonStyle}"
                        Width="95"
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,0"
                        Command="{Binding SaveRateCommand}"/>


                <!-- ================================= -->
                <!-- DELETE                             -->
                <!-- ================================= -->

                <Button Grid.Column="4"
                        Content="Delete"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="95"
                        VerticalAlignment="Bottom"
                        Command="{Binding DeleteRateCommand}"/>

            </Grid>

        </Border>


        <!-- ========================================= -->
        <!-- RATES TABLE                               -->
        <!-- ========================================= -->

        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="14"
                Padding="18">

            <DataGrid ItemsSource="{Binding Rates}"
                      SelectedItem="{Binding SelectedRate,
                                             Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Client"
                                        Binding="{Binding Client.Name}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Plate Type"
                                        Binding="{Binding PlateType.Code}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Rate (₹)"
                                        Binding="{Binding Rate,
                                                  StringFormat={}{0:N2}}"
                                        Width="1*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- ========================================= -->
        <!-- STATUS                                    -->
        <!-- ========================================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="14"
                   Margin="5,12,0,0"
                   TextWrapping="Wrap"/>

    </Grid>

</UserControl>