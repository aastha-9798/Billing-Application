<Window x:Class="PlateBilling.Views.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore from Backup"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7FB">

    <Window.Resources>

        <Style TargetType="DataGrid">
            <Setter Property="FontSize"               Value="15"/>
            <Setter Property="Foreground"             Value="#172033"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="RowHeight"              Value="38"/>
            <Setter Property="GridLinesVisibility"    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F4"/>
            <Setter Property="HeadersVisibility"      Value="Column"/>
            <Setter Property="AutoGenerateColumns"    Value="False"/>
            <Setter Property="IsReadOnly"             Value="True"/>
            <Setter Property="CanUserAddRows"         Value="False"/>
            <Setter Property="SelectionMode"          Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="Padding"    Value="10,8"/>
        </Style>

        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="10,0"/>
        </Style>

        <Style x:Key="NumberCellStyle" TargetType="TextBlock"
               BasedOn="{StaticResource CellStyle}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">

            <TextBlock Text="Restore from Backup"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#172033"/>

            <TextBlock FontSize="13"
                       Foreground="#667085"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0">
                Choose the backup to go back to. Your current data is saved as a backup first,
                so a restore can be undone. The app restarts afterwards.
            </TextBlock>

        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="BackupsGrid"
                      SelectionChanged="BackupsGrid_SelectionChanged"
                      MouseDoubleClick="BackupsGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding Backup.Tier}"
                                        ElementStyle="{StaticResource CellStyle}"
                                        Width="0.8*"/>

                    <DataGridTextColumn Header="Taken at"
                                        Binding="{Binding Backup.TakenAt, StringFormat={}{0:dd MMM yyyy, hh:mm tt}}"
                                        ElementStyle="{StaticResource CellStyle}"
                                        Width="1.6*"/>

                    <DataGridTextColumn Header="Challans"
                                        Binding="{Binding ChallanText}"
                                        ElementStyle="{StaticResource NumberCellStyle}"
                                        Width="0.9*"/>

                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding SizeText}"
                                        ElementStyle="{StaticResource NumberCellStyle}"
                                        Width="0.8*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <Grid Grid.Row="2"
              Margin="0,14,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#B42318"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    Background="#F2F4F7"
                    Foreground="#172033"
                    BorderBrush="#E4E7EC"
                    Margin="10,0,0,0"/>

            <Button x:Name="RestoreButton"
                    Grid.Column="2"
                    Content="Restore"
                    IsEnabled="False"
                    Background="#B42318"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="10,0,0,0"
                    Click="RestoreButton_Click"/>

        </Grid>

    </Grid>

</Window>
