<UserControl x:Class="PlateBilling.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F6F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,20">

            <StackPanel>

                <TextBlock Text="Reports"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="View challan transactions and totals"
                           FontSize="15"
                           Foreground="#667085"
                           Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- FILTERS                                           -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Client -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,18,0">

                    <TextBlock Text="Client"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <ComboBox ItemsSource="{Binding ClientOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedClientOption,
                                                     Mode=TwoWay}"
                              Height="42"
                              FontSize="15"/>

                </StackPanel>


                <!-- Start Date -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,18,0">

                    <TextBlock Text="Start Date"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <DatePicker SelectedDate="{Binding StartDate,
                                                      Mode=TwoWay}"
                                Height="42"
                                FontSize="15"/>

                </StackPanel>


                <!-- End Date -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,18,0">

                    <TextBlock Text="End Date"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <DatePicker SelectedDate="{Binding EndDate,
                                                      Mode=TwoWay}"
                                Height="42"
                                FontSize="15"/>

                </StackPanel>


                <!-- Preview -->

                <Button Grid.Column="3"
                        Content="Preview / Print"
                        Width="145"
                        Height="42"
                        VerticalAlignment="Bottom"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="PreviewPrintButton_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- REPORT TABLE                                      -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- Report period -->

                <TextBlock Grid.Row="0"
                           Text="{Binding ReportPeriod}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#667085"
                           Margin="5,0,0,12"/>


                <!-- Table -->

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Client Name"
                                            Binding="{Binding ClientName}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="Challan No."
                                            Binding="{Binding ChallanNo}"
                                            Width="1.2*"/>

                        <DataGridTextColumn Header="Plate Type"
                                            Binding="{Binding PlateTypeCode}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="0.9*"/>

                        <DataGridTextColumn Header="Rate"
                                            Binding="{Binding Rate,
                                                     StringFormat={}{0:₹#,##0.00}}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount,
                                                     StringFormat={}{0:₹#,##0.00}}"
                                            Width="1.2*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- GRAND TOTAL                                       -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="14"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Grand Total"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding GrandTotal,
                                          StringFormat={}{0:₹#,##0.00}}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>