<UserControl x:Class="PlateBilling.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PlateBilling.Models">

    <UserControl.Resources>

        <!-- Converts ReportType enum value to display string -->
        <ObjectDataProvider x:Key="ReportTypeNames"
                            MethodName="GetNames"
                            ObjectType="{x:Type models:ReportType}"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    </UserControl.Resources>

    <Grid Background="#F6F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER                                            -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="4,0,4,20">

            <StackPanel>

                <TextBlock Text="Reports"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="View challan transactions and totals"
                           FontSize="15"
                           Foreground="#667085"
                           Margin="0,4,0,0"/>

            </StackPanel>

        </Grid>


        <!-- ================================================= -->
        <!-- FILTERS                                           -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Report Type -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,18,0">

                    <TextBlock Text="Report Type"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <ComboBox ItemsSource="{Binding ReportTypes}"
                              SelectedItem="{Binding SelectedReportType, Mode=TwoWay}"
                              Height="42"
                              FontSize="15"/>

                </StackPanel>


                <!-- Client -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,18,0">

                    <TextBlock Text="Client"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <ComboBox ItemsSource="{Binding ClientOptions}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedClientOption, Mode=TwoWay}"
                              Height="42"
                              FontSize="15"/>

                </StackPanel>


                <!-- Start Date -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,18,0">

                    <TextBlock Text="Start Date"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                Height="42"
                                FontSize="15"/>

                </StackPanel>


                <!-- End Date -->

                <StackPanel Grid.Column="3"
                            Margin="0,0,18,0">

                    <TextBlock Text="End Date"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               Margin="0,0,0,7"/>

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                Height="42"
                                FontSize="15"/>

                </StackPanel>


                <!-- Preview / Print -->

                <Button Grid.Column="4"
                        Content="Preview / Print"
                        Width="145"
                        Height="42"
                        VerticalAlignment="Bottom"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Click="PreviewPrintButton_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- CLIENT INFO STRIP (single-client detailed only)   -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="#EEF2FF"
                CornerRadius="10"
                Padding="16,10"
                Margin="0,0,0,12">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsDetailedReport}" Value="True"/>
                                <Condition Binding="{Binding IsSingleClient}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding ReportClientInfo}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#3730A3"/>

        </Border>


        <!-- ================================================= -->
        <!-- REPORT TABLE                                      -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="14"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Report period + error -->

                <TextBlock Grid.Row="0"
                           Text="{Binding ReportPeriod}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#667085"
                           Margin="5,0,0,6"/>

                <TextBlock Grid.Row="1"
                           Text="{Binding ErrorMessage}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B42318"
                           Margin="5,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>


                <!-- =========================================== -->
                <!-- DETAILED REPORT GRID                        -->
                <!-- =========================================== -->

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Visibility="{Binding IsDetailedReport,
                                       Converter={StaticResource BoolToVis}}">

                    <DataGrid.Columns>

                        <!-- S.No — always visible -->
                        <DataGridTextColumn Header="S.No"
                                            Binding="{Binding RowNumber}"
                                            Width="55"/>

                        <!-- Client Name — only for All Clients -->
                        <DataGridTextColumn Header="Client Name"
                                            Binding="{Binding ClientName}"
                                            Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="4,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSingleClient,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSingleClient,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Challan No."
                                            Binding="{Binding ChallanNo}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Plate Type"
                                            Binding="{Binding PlateTypeCode}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="0.9*"/>

                        <DataGridTextColumn Header="Rate"
                                            Binding="{Binding Rate, StringFormat={}{0:N2}}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                            Width="1.2*"/>

                    </DataGrid.Columns>

                </DataGrid>


                <!-- =========================================== -->
                <!-- CUMULATIVE REPORT GRID                      -->
                <!-- =========================================== -->

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CumulativeRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Visibility="{Binding IsCumulativeReport,
                                       Converter={StaticResource BoolToVis}}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="S.No"
                                            Binding="{Binding RowNumber}"
                                            Width="55"/>

                        <DataGridTextColumn Header="Plate Type"
                                            Binding="{Binding PlateTypeCode}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Rate"
                                            Binding="{Binding Rate, StringFormat={}{0:N2}}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Amount"
                                            Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                            Width="1.2*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- GRAND TOTAL                                       -->
        <!-- ================================================= -->

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="14"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Grand Total"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#172033"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>
